---
import Base from '../layouts/Base.astro';
import MinimalNav from '../components/portfolio/MinimalNav.astro';
import WorkSection from '../components/portfolio/WorkSection.astro';
import CreateSection from '../components/portfolio/CreateSection.astro';
import LovesSection from '../components/portfolio/LovesSection.astro';
import ContactFooter from '../components/portfolio/ContactFooter.astro';
---

<Base title="Kaung Thiha" slimNav={false}>
<!-- Ambient forest (Three.js, fixed full-viewport, behind everything). Most
     present on the hero, quiet while reading. -->
<div class="tree-canvas-host" id="tree-canvas-host" aria-hidden="true"></div>

<!-- ─────────────────────────────────────────────────────────────────────
     Hero — the landscape is the point here; the UI stays small.
     ───────────────────────────────────────────────────────────────────── -->
<section class="hero-intro" id="top" aria-label="Introduction">
  <div class="hero-intro-inner">
    <img class="hero-portrait"
         src="/assets/images/about.jpg"
         alt="Kaung Thiha"
         loading="eager"
         width="260" height="260">
    <h1 class="hero-name">
      I'm Kaung
      <span class="burmese">(ကောင်းသီဟ)</span>
      <span class="identity-weather-line local-weather-status" aria-live="polite">Checking the weather in Arlington, Virginia…</span>
    </h1>

    <ul class="hero-socials">
      <li>
        <a href="https://www.linkedin.com/in/kaungthiha/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
          </svg>
        </a>
      </li>
      <li>
        <a href="https://open.spotify.com/user/22k3hzyma66fj4nbmanjastiy?si=ea605d91ddae4bb2" target="_blank" rel="noopener" aria-label="Spotify">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.669 11.538a.498.498 0 0 1-.686.165c-1.879-1.147-4.243-1.407-7.028-.77a.499.499 0 0 1-.222-.973c3.048-.696 5.662-.397 7.77.892a.5.5 0 0 1 .166.686zm.979-2.178a.624.624 0 0 1-.858.205c-2.15-1.321-5.428-1.704-7.972-.932a.625.625 0 0 1-.362-1.194c2.905-.881 6.517-.454 8.986 1.063a.624.624 0 0 1 .206.858zm.084-2.268C10.154 5.56 5.9 5.419 3.438 6.166a.748.748 0 1 1-.434-1.432c2.825-.857 7.523-.692 10.492 1.07a.747.747 0 1 1-.764 1.288z"/>
          </svg>
        </a>
      </li>
    </ul>

    <a class="hero-scroll-cue" href="#work">explore <span aria-hidden="true">↓</span></a>
  </div>
</section>

<MinimalNav />

<!-- ─────────────────────────────────────────────────────────────────────
     One scrolling document: work → create → loves → say hi. Everything is
     in normal flow; nothing needs JS to be readable.
     ───────────────────────────────────────────────────────────────────── -->
<div class="home-content">
  <div class="home-inner">
    <WorkSection />
    <CreateSection />
    <LovesSection />
    <ContactFooter />
  </div>
</div>

<script>
  import '../scripts/homepage-observer';
</script>

<!-- WebGL forest — bundled, code-split ES module island. Dynamically imported
     on idle so the Three.js + EZ-Tree bundle never blocks first paint. -->
<script>
  const host = document.getElementById('tree-canvas-host');
  if (host) {
    const boot = () => import('../scripts/forest').then((m) => m.initForest(host));
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(boot, { timeout: 2000 });
    } else {
      setTimeout(boot, 200);
    }
  }
</script>
</Base>
