---
/**
 * A sprig of jasmine, for my mom: the quiet mark beside her line at the end
 * of Loves. Drawn here as inline SVG in the grove's palette; purely
 * decorative (the words beside it carry the meaning).
 */
// A five-petalled blossom at (x, y), turned by `turn` degrees, of radius r.
const blossom = (x: number, y: number, r: number, turn: number) =>
  Array.from({ length: 5 }, (_, i) => ({ x, y, r, a: turn + i * 72 }));
const blossoms = [...blossom(47, 15, 6.4, 8), ...blossom(31, 22, 5.6, -20), ...blossom(58, 30, 5, 30)];
const hearts = [[47, 15], [31, 22], [58, 30]];
---

<svg class="jasmine" viewBox="0 0 72 52" aria-hidden="true" focusable="false">
  <path d="M4 48C18 44 30 38 40 28S54 14 60 6" fill="none" stroke="#6b7f5e" stroke-width="1.4" stroke-linecap="round" />
  <path d="M40 28C46 30 52 31 57 30M32 34C30 30 30 26 31 23" fill="none" stroke="#6b7f5e" stroke-width="1" stroke-linecap="round" />
  <g fill="url(#grove-leaf)" stroke="rgba(214,166,95,0.35)" stroke-width="0.5">
    <path transform="translate(14 45) rotate(-62)" d="M0 0C4-5 12-5 16 0 12 5 4 5 0 0Z" />
    <path transform="translate(22 41) rotate(18)" d="M0 0C4-4.6 11-4.6 15 0 11 4.6 4 4.6 0 0Z" />
    <path transform="translate(36 32) rotate(-128)" d="M0 0C3.5-4 9.5-4 13 0 9.5 4 3.5 4 0 0Z" />
  </g>
  <g fill="#f3ecd8">
    {blossoms.map((p) => (
      <ellipse cx={p.x} cy={p.y - p.r * 0.55} rx={p.r * 0.34} ry={p.r * 0.58} transform={`rotate(${p.a} ${p.x} ${p.y})`} />
    ))}
    <!-- Two buds still closed, near the tip. -->
    <ellipse cx="59" cy="9" rx="1.6" ry="3.2" transform="rotate(32 59 9)" />
    <ellipse cx="54" cy="19" rx="1.4" ry="2.8" transform="rotate(60 54 19)" />
  </g>
  <g fill="#d6a65f">{hearts.map(([x, y]) => <circle cx={x} cy={y} r="1.1" />)}</g>
</svg>
