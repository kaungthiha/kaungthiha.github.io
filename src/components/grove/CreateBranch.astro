---
/**
 * Create, as a branch: one twig per featured project story, then the small
 * experiments as lighter twigs. Same canonical records as the homepage.
 */
import BranchNode from './BranchNode.astro';
import ProjectStory from '../portfolio/ProjectStory.astro';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';
import { getProjects } from '../../lib/career';

const { create } = portfolioConfig;
const featured = getProjects(create.featuredProjectIds);
const experiments = getProjects(create.experimentProjectIds);
---

<section class="branch" id="create" aria-labelledby="create-title">
  <BranchNode label="Create" icon="create" />
  <h2 class="section-heading" id="create-title">{create.heading}</h2>

  <ol class="twigs twigs--stories">
    {featured.map((p) => <li class="twig"><ProjectStory project={p} /></li>)}
  </ol>

  {experiments.length > 0 && (
    <div class="ring-group">
      <p class="ring"><span>{create.experimentsHeading}</span></p>
      <ul class="twigs">
        {experiments.map((p) => {
          const link = p.links?.[0];
          const external = link ? link.url.startsWith('http') || link.kind === 'pdf' : false;
          return (
            <li class="twig twig--minor twig--experiment">
              {link ? (
                <a
                  class="experiment-name"
                  href={link.url}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >{p.title}</a>
              ) : (
                <span class="experiment-name">{p.title}</span>
              )}
              {(p.website_summary ?? p.summary) && <span class="experiment-blurb">{p.website_summary ?? p.summary}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</section>
