---
/**
 * Work, as a branch of the trunk: the full career timeline from the canonical
 * dataset (the same records as /career/), one twig per employer, grouped under
 * year rings, then earlier roles, education, and skills.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import CareerEntry from '../career/CareerEntry.astro';
import BranchNode from './BranchNode.astro';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';
import {
  getCareerEducation,
  getCareerTimeline,
  getCurrentRole,
  getLeadership,
  getPublicSkills,
  yearRange,
} from '../../lib/career';

const { work, career, create, skillGroups } = portfolioConfig;

// One pass over main + earlier employers so overlaps are detected across both.
const all = getCareerTimeline({
  experienceIds: [...career.experienceIds, ...career.earlierExperienceIds],
  achievementsPerRole: career.achievementsPerRole,
  relatedProjectIds: create.featuredProjectIds,
});
const isMain = (id: string) => career.experienceIds.includes(id);
const groups = all
  .map((g) => ({ ...g, entries: g.entries.filter((e) => isMain(e.experience.id)) }))
  .filter((g) => g.entries.length > 0);
const earlier = all.flatMap((g) => g.entries).filter((e) => !isMain(e.experience.id));
const leadership = getLeadership(career.leadershipIds);
const education = career.showEducation ? getCareerEducation() : [];
const skills = career.showSkills ? getPublicSkills(skillGroups) : [];
const current = getCurrentRole();
const hasResume = existsSync(join(process.cwd(), 'public', work.resumeHref));
---

<section class="branch" id="work" aria-labelledby="work-title">
  <BranchNode label="Work" icon="work" />
  <h2 class="section-heading" id="work-title">{work.heading}</h2>
  <p class="section-intro">
    {work.intro}
    {current && (
      <> Right now: {current.role.canonical_title}{current.role.team_or_scope && `, ${current.role.team_or_scope}`}, at {current.experience.organization}.</>
    )}
  </p>

  {groups.map((g) => (
    <div class="ring-group">
      <p class="ring"><span>{g.label}</span></p>
      <ol class="twigs">
        {g.entries.map((entry) => <CareerEntry entry={entry} class="twig twig--role" storyBase="" />)}
      </ol>
    </div>
  ))}

  {(earlier.length > 0 || leadership.length > 0) && (
    <div class="ring-group">
      <p class="ring"><span>Earlier</span></p>
      <ol class="twigs">
        {earlier.map((entry) => <CareerEntry entry={entry} class="twig twig--role twig--minor" storyBase="" />)}
        {leadership.map((l) => (
          <li class="twig twig--role twig--minor" id={l.id}>
            <h3 class="timeline-org">{l.organization}</h3>
            <div class="timeline-role">
              <p class="timeline-dates">{yearRange({ start_date: l.start_date, end_date: l.end_date, current: false })}</p>
              <p class="timeline-title">{l.canonical_title}</p>
              {l.summary && <p class="timeline-summary">{l.summary}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  )}

  {education.length > 0 && (
    <div class="ring-group">
      <p class="ring"><span>Education</span></p>
      <ul class="twigs">
        {education.map((e) => (
          <li class="twig twig--minor">
            <h3 class="timeline-org">{e.institution}</h3>
            <p class="timeline-title">{e.credential}</p>
            <p class="timeline-dates">{e.when}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  {skills.length > 0 && (
    <div class="ring-group">
      <p class="ring"><span>Skills</span></p>
      <ul class="twigs">
        <li class="twig twig--minor">
          <p class="skills-line">
            {skills.map((g) => (
              <span class="skills-group"><span class="skills-name">{g.label}</span> {g.items.join(' · ')}</span>
            ))}
          </p>
          {hasResume && (
            <p class="section-cta"><a class="text-link" href={work.resumeHref} target="_blank" rel="noopener">Résumé (PDF) →</a></p>
          )}
        </li>
      </ul>
    </div>
  )}
</section>
