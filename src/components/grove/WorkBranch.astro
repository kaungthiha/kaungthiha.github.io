---
/**
 * Work, as a branch of the trunk: the career from the canonical dataset.
 * A timeline map (CareerMap) lays the employers out along time, forking off
 * college; below it each employer is a twig. With JS the map picks which
 * one twig is shown (career-map.ts), so the branch stays short; without it
 * they are all listed. Then extracurriculars, education, skills.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import CareerEntry from '../career/CareerEntry.astro';
import CareerMap from '../career/CareerMap.astro';
import BranchNode from './BranchNode.astro';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';
import {
  getCareerEducation,
  getCareerTimeline,
  getCurrentRole,
  getLeadership,
  getPublicSkills,
} from '../../lib/career';

const { work, career, create, skillGroups } = portfolioConfig;

// One pass over main + earlier employers so overlaps are detected across both.
const all = getCareerTimeline({
  experienceIds: [...career.experienceIds, ...career.earlierExperienceIds],
  achievementsPerRole: career.achievementsPerRole,
  relatedProjectIds: create.featuredProjectIds,
});
const entries = all.flatMap((g) => g.entries);
const leadership = getLeadership(career.leadershipIds);
const education = career.showEducation ? getCareerEducation() : [];
const skills = career.showSkills ? getPublicSkills(skillGroups) : [];
const current = getCurrentRole();
const hasResume = existsSync(join(process.cwd(), 'public', work.resumeHref));

const rightNow = current
  ? `Right now: ${current.role.canonical_title}${current.role.team_or_scope ? `, ${current.role.team_or_scope}` : ''}, at ${current.experience.organization}.`
  : '';
// Twigs grow in order down the whole branch.
let n = 0;
---

<details class="branch" id="work" open>
  <BranchNode label="Work" icon="work" teaser={work.heading} sub={rightNow} />
  <div class="branch-body">
    <h2 class="section-heading">{work.heading}</h2>
    {(work.intro || rightNow) && <p class="section-intro">{work.intro} {rightNow}</p>}

    <CareerMap />
    <ol class="twigs map-panels">
      {entries.map((entry) => <CareerEntry entry={entry} index={n++} />)}
    </ol>

    {leadership.length > 0 && (
      <div class="ring-group">
        <p class="ring"><span>Extracurriculars</span></p>
        <ol class="twigs">
          {leadership.map((l) => (
            <li class="twig twig--role twig--minor" id={l.id} style={`--i: ${n++}`}>
              <h3 class="timeline-org">{l.organization}</h3>
              <p class="twig-sub">{l.canonical_title}</p>
              {l.summary && <p class="timeline-summary">{l.summary}</p>}
            </li>
          ))}
        </ol>
      </div>
    )}

    {education.length > 0 && (
      <div class="ring-group">
        <p class="ring"><span>Education</span></p>
        <ul class="twigs">
          {education.map((e) => (
            <li class="twig twig--minor" style={`--i: ${n++}`}>
              <h3 class="timeline-org">{e.institution}</h3>
              <p class="twig-sub">{e.credential} · {e.when}</p>
            </li>
          ))}
        </ul>
      </div>
    )}

    {skills.length > 0 && (
      <div class="ring-group">
        <p class="ring"><span>Skills</span></p>
        <ul class="twigs">
          <li class="twig twig--minor twig--skills" style={`--i: ${n++}`}>
            <p class="skills-line">
              {skills.map((g) => (
                <span class="skills-group"><span class="skills-name">{g.label}</span> {g.items.join(' · ')}</span>
              ))}
            </p>
            {hasResume && (
              <p class="section-cta"><a class="text-link" href={work.resumeHref} target="_blank" rel="noopener">Résumé (PDF) →</a></p>
            )}
          </li>
        </ul>
      </div>
    )}
  </div>
</details>
