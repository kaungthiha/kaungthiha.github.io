---
/**
 * The grove: everything after the landing, grown along one golden trunk.
 * Work, Stuff and Loves are branches (<details>); their items are twigs.
 * Without JS every branch is open: a plain, fully readable document. With
 * src/scripts/grove.ts it starts as an overview at the root; opening one
 * branch grows its twigs while the others zoom out, and the light travels
 * down the trunk to it.
 */
import WorkBranch from './WorkBranch.astro';
import CreateBranch from './CreateBranch.astro';
import LovesBranch from './LovesBranch.astro';
import ContactFooter from '../portfolio/ContactFooter.astro';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';

const sections = [
  { id: 'work', label: 'Work' },
  { id: 'create', label: portfolioConfig.create.label },
  { id: 'loves', label: 'Loves' },
];
---

<div class="grove" id="grove" data-grove>
  <!-- One leaf sprig, drawn once and reused beside every node. -->
  <svg class="grove-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="grove-leaf" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3d5642" />
        <stop offset="1" stop-color="#8fa47d" />
      </linearGradient>
      <symbol id="grove-sprig" viewBox="0 0 60 80">
        <path d="M32 80C30 60 34 40 30 6" fill="none" stroke="#6b7f5e" stroke-width="1.4" stroke-linecap="round" />
        <g fill="url(#grove-leaf)" stroke="rgba(214,166,95,0.4)" stroke-width="0.6">
          <path transform="translate(31 63) rotate(-152)" d="M0 0C6-5.5 16-5.5 22 0 16 5.5 6 5.5 0 0Z" />
          <path transform="translate(32 53) rotate(-28)" d="M0 0C6-5.5 16-5.5 22 0 16 5.5 6 5.5 0 0Z" />
          <path transform="translate(31 39) rotate(-156)" d="M0 0C5-4.8 14-4.8 19 0 14 4.8 5 4.8 0 0Z" />
          <path transform="translate(32 29) rotate(-34)" d="M0 0C5-4.8 14-4.8 19 0 14 4.8 5 4.8 0 0Z" />
          <path transform="translate(30 12) rotate(-96)" d="M0 0C4-4 11-4 15 0 11 4 4 4 0 0Z" />
        </g>
      </symbol>
    </defs>
  </svg>

  <!-- The mini-trunk: jump between branches. A vertical trunk in the left
       margin on wide screens, a horizontal one along the top on narrow. -->
  <nav class="mini-trunk" aria-label="Sections">
    <span class="mini-line" aria-hidden="true"><span class="mini-lit"></span></span>
    <ol>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-section={s.id}><span class="mini-dot" aria-hidden="true"></span><span class="mini-label">{s.label}</span></a></li>
      ))}
    </ol>
  </nav>

  <div class="grove-col">
    <div class="trunk" aria-hidden="true">
      <span class="trunk-lit"></span>
    </div>
    <svg class="trunk-crown" viewBox="0 0 60 80" aria-hidden="true"><use href="#grove-sprig" /></svg>
    <p class="grove-hint">Pick a branch</p>

    <WorkBranch />
    <CreateBranch />
    <LovesBranch />
  </div>

  <!-- The trunk ends in a root node just above the closing links. -->
  <div class="grove-end">
    <ContactFooter />
  </div>
</div>
