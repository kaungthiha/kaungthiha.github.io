---
/**
 * The grove: everything after the landing, as one tree. A painted banyan
 * stands at the top (one painting per season); a golden root runs from its
 * foot down the page, and Work, Stuff and Loves are limbs that grow off it
 * (<details>); their items are twigs.
 * Without JS every branch is open: a plain, fully readable document. With
 * src/scripts/grove.ts it starts as an overview at the root; opening one
 * branch grows its twigs while the others zoom out, and the light travels
 * down the trunk to it. The script also draws the tree itself (.grove-tree):
 * a gently uneven trunk, and the open branch's own spine growing off it.
 */
import WorkBranch from './WorkBranch.astro';
import CreateBranch from './CreateBranch.astro';
import LovesBranch from './LovesBranch.astro';
import ContactFooter from '../portfolio/ContactFooter.astro';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';

const sections = [
  { id: 'work', label: 'Work' },
  { id: 'create', label: portfolioConfig.create.label },
  { id: 'loves', label: 'Loves' },
];
---

<div class="grove" id="grove" data-grove>
  <svg class="grove-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="grove-leaf" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3d5642" />
        <stop offset="1" stop-color="#8fa47d" />
      </linearGradient>
      <!-- Padauk (ပိတောက်), Myanmar's April flower: pinnate leaves and sprays of
           small notched pea-flowers. A memory of Yangon, shown on the Loves
           branch in April (src/scripts/season.ts); not a claim about Arlington. -->
      <symbol id="grove-padauk" viewBox="0 0 60 80">
        <path d="M32 80C30 62 34 44 30 15" fill="none" stroke="#6b7f5e" stroke-width="1.4" stroke-linecap="round" />
        <path d="M31 64L11 52M32 52L50 43" fill="none" stroke="#6b7f5e" stroke-width="0.8" stroke-linecap="round" />
        <path d="M31 36C25 32 20 26 16 12M31 25C37 22 41 16 44.5 5M30.5 20L29.5 11" fill="none" stroke="#7f8a58" stroke-width="0.9" stroke-linecap="round" />
        <g fill="url(#grove-leaf)" stroke="rgba(214,166,95,0.4)" stroke-width="0.5">
          <path transform="translate(26 61) rotate(156)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(22 58.6) rotate(-94)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(18 56.2) rotate(156)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(14.2 53.9) rotate(-94)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(11 52) rotate(-149)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(36.5 49.7) rotate(-82)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(41 47.5) rotate(28)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(45.5 45.2) rotate(-82)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
          <path transform="translate(50 43) rotate(-27)" d="M0 0C2.5-2.7 6.5-2.7 9 0 6.5 2.7 2.5 2.7 0 0Z" />
        </g>
        <g fill="#b98a3c"><circle cx="16.6" cy="14" r="1.3" /><circle cx="15.4" cy="10.6" r="0.9" /><circle cx="43.3" cy="8.6" r="1.2" /><circle cx="44.6" cy="5.4" r="0.8" /><circle cx="29.6" cy="12" r="1.1" /></g>
        <path transform="translate(27 33) rotate(20)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(23.5 28.5) rotate(-35)" fill="#ecc869" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(21 23) rotate(60)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(18.5 18.6) rotate(-10)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(26 25.5) rotate(140)" fill="#ecc869" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(30.5 17.5) rotate(-60)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(35 22.5) rotate(35)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(38.5 18) rotate(-20)" fill="#ecc869" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(41 13.2) rotate(80)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(36 14.5) rotate(170)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(33 28) rotate(-100)" fill="#ecc869" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <path transform="translate(22 33.5) rotate(100)" fill="#dbaf52" d="M0 1.9C-2.6 1.7-3.6-0.5-2.5-2-1.5-3.2-0.2-2.5 0-1.3 0.2-2.5 1.5-3.2 2.5-2 3.6-0.5 2.6 1.7 0 1.9Z" />
        <g fill="#b0702f"><circle cx="27" cy="33.3" r="0.55" /><circle cx="21" cy="23.3" r="0.55" /><circle cx="26" cy="25.8" r="0.55" /><circle cx="35" cy="22.8" r="0.55" /><circle cx="41" cy="13.5" r="0.55" /><circle cx="33" cy="28.3" r="0.55" /></g>
      </symbol>
    </defs>
  </svg>

  <!-- The mini-trunk: jump between branches. A vertical trunk in the left
       margin on wide screens, a horizontal one along the top on narrow. -->
  <nav class="mini-trunk" aria-label="Sections">
    <span class="mini-line" aria-hidden="true"><span class="mini-lit"></span></span>
    <ol>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-section={s.id}><span class="mini-dot" aria-hidden="true"></span><span class="mini-label">{s.label}</span></a></li>
      ))}
    </ol>
    <a class="mini-back" href="#grove" aria-label="Back to all branches"><span aria-hidden="true">↑</span><span class="mini-back-label">All branches</span></a>
  </nav>

  <div class="grove-col">
    <div class="trunk" aria-hidden="true">
      <span class="trunk-lit"></span>
    </div>
    <!-- The drawn tree (grove.ts sets the paths from where the nodes sit). -->
    <svg class="grove-tree" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="tree-dim" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="64">
          <stop offset="0" stop-color="#d6a65f" stop-opacity="0" />
          <stop offset="1" stop-color="#d6a65f" stop-opacity="0.24" />
        </linearGradient>
        <linearGradient id="tree-gold" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="48">
          <stop offset="0" stop-color="#e8c27f" stop-opacity="0" />
          <stop offset="1" stop-color="#e8c27f" />
        </linearGradient>
      </defs>
      <path class="tree-trunk" />
      <path class="tree-lit" pathLength="1" />
      <path class="tree-spine" pathLength="1" />
      <circle class="tree-spark" r="4" />
    </svg>
    <!-- The banyan the whole grove grows from (grove.css picks the season's painting). -->
    <div class="grove-banyan" aria-hidden="true"></div>
    <p class="grove-hint">Pick a branch</p>

    <WorkBranch />
    <CreateBranch />
    <LovesBranch />
  </div>

  <!-- The trunk ends in a root node just above the closing links. -->
  <div class="grove-end">
    <ContactFooter />
  </div>
</div>
