---
/**
 * Loves, as a branch: each field note is a small twig with its category.
 */
import BranchNode from './BranchNode.astro';
import { loves, lovesHeading, fieldPhoto } from '../../data/loves';
---

<section class="branch" id="loves" aria-labelledby="loves-title">
  <BranchNode label="Loves" icon="loves" />
  <h2 class="section-heading" id="loves-title">{lovesHeading}</h2>

  <ul class="twigs twigs--notes">
    {loves.map((item) => (
      <li class="twig twig--minor twig--note">
        <span class="note-category">{item.category}</span>
        <p class="note-text">
          {item.href ? (
            <a class="field-lead" href={item.href} target="_blank" rel="noopener">{item.lead}</a>
          ) : (
            <span class="field-lead">{item.lead}</span>
          )}{' '}
          {item.note}
        </p>
      </li>
    ))}
  </ul>

  {fieldPhoto && (
    <figure class="field-photo">
      <img src={fieldPhoto.src} alt={fieldPhoto.alt} loading="lazy" decoding="async" />
      {fieldPhoto.caption && <figcaption>{fieldPhoto.caption}</figcaption>}
    </figure>
  )}
</section>
