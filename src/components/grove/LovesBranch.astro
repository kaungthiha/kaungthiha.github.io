---
/**
 * Loves, as a branch: each field note is a small twig with its category.
 * The notes change over time; the section closes on the two that don't
 * (`always` in src/data/loves.ts): home, and my mom.
 */
import BranchNode from './BranchNode.astro';
import YangonVignette from './YangonVignette.astro';
import Jasmine from './Jasmine.astro';
import { always, loves, lovesHeading, fieldPhoto, yangonVignette } from '../../data/loves';

const sub = loves.map((item) => item.category).join(', ') + '.';
---

<details class="branch" id="loves" open>
  <BranchNode label="Loves" icon="loves" teaser={lovesHeading} sub={sub} accent="padauk" />
  <div class="branch-body">
    <h2 class="section-heading">{lovesHeading}</h2>

    <ul class="twigs twigs--notes">
      {loves.map((item, i) => (
        <li class="twig twig--minor twig--note" style={`--i: ${i}`}>
          <span class="note-category">{item.category}</span>
          <p class="note-text">
            {item.href ? (
              <a class="field-lead" href={item.href} target="_blank" rel="noopener">{item.lead}</a>
            ) : (
              <span class="field-lead">{item.lead}</span>
            )}{' '}
            {item.note}
          </p>
        </li>
      ))}
    </ul>

    {fieldPhoto && (
      <figure class="field-photo">
        <img src={fieldPhoto.src} alt={fieldPhoto.alt} loading="lazy" decoding="async" />
        {fieldPhoto.caption && <figcaption>{fieldPhoto.caption}</figcaption>}
      </figure>
    )}

    <div class="loves-always">
      <p class="ring"><span>{always.heading}</span></p>
      {yangonVignette && <YangonVignette caption={always.home} />}
      <p class="loves-mom"><Jasmine /><span>{always.mom}</span></p>
    </div>
  </div>
</details>
