---
/**
 * One employer on the career timeline: every canonical role under it (newest
 * first), a canonical summary, and a few selected outcomes. Overlaps with
 * other employers and related projects are derived, never written by hand.
 *
 * `collapsible` renders it as a grove twig: a one-line head (employer, role
 * or role count, years) that opens to the full detail.
 */
import CareerEntryBody from './CareerEntryBody.astro';
import { organizationLabel, yearRange, type TimelineEntry } from '../../lib/career';

interface Props {
  entry: TimelineEntry;
  /** List-item class: the /career/ timeline by default, a branch twig in the grove. */
  class?: string;
  /** Where project stories live: the homepage by default, '' for the same page. */
  storyBase?: string;
  collapsible?: boolean;
  /** Position within its branch, for the staggered growth animation. */
  index?: number;
}

const { entry, class: className = 'timeline-entry', storyBase = '/', collapsible = false, index = 0 } = Astro.props;
const exp = entry.experience;

const newest = entry.roles[0]?.role;
const oldest = entry.roles[entry.roles.length - 1]?.role;
const span = newest && oldest
  ? yearRange({ start_date: oldest.start_date, end_date: newest.end_date, current: newest.current })
  : '';
const sub = entry.roles.length > 1 ? `${entry.roles.length} roles · ${span}` : `${newest?.canonical_title} · ${span}`;
---

{collapsible ? (
  <li class={className} id={exp.id} style={`--i: ${index}`}>
    <details class="twig-details" open>
      <summary class="twig-head">
        <span class="timeline-org">{organizationLabel(exp)}</span>
        <span class="twig-sub">{sub}</span>
      </summary>
      <div class="twig-body">
        <CareerEntryBody entry={entry} storyBase={storyBase} />
      </div>
    </details>
  </li>
) : (
  <li class={className} id={exp.id}>
    <h3 class="timeline-org">{organizationLabel(exp)}</h3>
    <CareerEntryBody entry={entry} storyBase={storyBase} />
  </li>
)}
