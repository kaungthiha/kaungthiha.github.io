---
/**
 * One employer on the Work branch, as a twig: a one-line head (employer, role
 * or role count, years) that opens to every canonical role under it (newest
 * first), a summary, and a few selected outcomes. Overlaps with other
 * employers and related projects are derived, never written by hand.
 */
import { organizationLabel, sentenceCase, yearRange, type TimelineEntry } from '../../lib/career';

interface Props {
  entry: TimelineEntry;
  class?: string;
  /** Position within its branch, for the staggered growth animation. */
  index?: number;
}

const { entry, class: className = 'twig twig--role', index = 0 } = Astro.props;
const exp = entry.experience;
const meta = [exp.location, exp.engagement_type && sentenceCase(exp.engagement_type)].filter(Boolean).join(' · ');

const newest = entry.roles[0]?.role;
const oldest = entry.roles[entry.roles.length - 1]?.role;
const span = newest && oldest
  ? yearRange({ start_date: oldest.start_date, end_date: newest.end_date, current: newest.current })
  : '';
const sub = entry.roles.length > 1 ? `${entry.roles.length} roles · ${span}` : `${newest?.canonical_title} · ${span}`;
---

<li class={className} id={exp.id} style={`--i: ${index}`}>
  <details class="twig-details" open>
    <summary class="twig-head">
      <span class="timeline-org">{organizationLabel(exp)}</span>
      <span class="twig-sub">{sub}</span>
    </summary>
    <div class="twig-body">
      {meta && <p class="timeline-meta">{meta}</p>}

      {entry.roles.map(({ role, range, achievements }) => (
        <div class="timeline-role">
          <p class="timeline-dates">{range}</p>
          <p class="timeline-title">{role.canonical_title}{role.team_or_scope && ` · ${role.team_or_scope}`}</p>
          {role.summary && <p class="timeline-summary">{role.summary}</p>}
          {achievements.length > 0 && (
            <ul class="timeline-outcomes">
              {achievements.map((a) => <li>{a.text}</li>)}
            </ul>
          )}
        </div>
      ))}

      {entry.alongside.length > 0 && (
        <p class="timeline-aside">Overlapped with {entry.alongside.join(' and ')}.</p>
      )}
      {entry.relatedProjects.length > 0 && (
        <p class="timeline-related">
          Related work:{' '}
          {entry.relatedProjects.map((p, i) => (
            <>{i > 0 && ', '}<a class="text-link" href={`#story-${p.id}`}>{p.title} →</a></>
          ))}
        </p>
      )}
    </div>
  </details>
</li>
