---
/**
 * Create — four featured project stories, then everything else as a quiet
 * "small experiments" list. All in normal document flow.
 */
import { projects } from '../../data/projects';
import ProjectStory from './ProjectStory.astro';

const featured = projects.filter((p) => p.featured);
const experiments = projects.filter((p) => !p.featured);
---

<section class="home-section" id="create" aria-labelledby="create-title">
  <p class="section-label">create</p>
  <h2 class="section-heading" id="create-title">Things I've built, tested, and learned from.</h2>

  <div class="stories">
    {featured.map((p) => <ProjectStory project={p} />)}
  </div>

  {experiments.length > 0 && (
    <div class="experiments">
      <h3 class="experiments-title">Small experiments</h3>
      <ul class="experiments-list">
        {experiments.map((p) => {
          const link = p.links?.[0];
          const external = link ? link.href.startsWith('http') || link.kind === 'pdf' : false;
          return (
            <li>
              {link ? (
                <a
                  class="experiment-name"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >{p.shortTitle ?? p.title}</a>
              ) : (
                <span class="experiment-name">{p.shortTitle ?? p.title}</span>
              )}
              {p.blurb && <span class="experiment-blurb">{p.blurb}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</section>
