---
/**
 * PortfolioShell — the centered editorial column below the hero. Holds the
 * sticky section switcher and the three sections (work / create / loves). The
 * forest stays visible around and behind it.
 *
 * The section-navigation client script is imported here as a bundled ES module
 * so it is code-split and deferred by Astro.
 */
import SectionSwitcher from './SectionSwitcher.astro';
import WorkSection from './WorkSection.astro';
import CreateSection from './CreateSection.astro';
import LovesSection from './LovesSection.astro';
---

<div class="pf-stage" id="pf-stage">
  <div class="pf-surface">
    <SectionSwitcher />
    <!-- data-active drives which panel shows (CSS-only); defaults to work so
         the correct section is visible even before/without JS. -->
    <div class="pf-panels" data-active="work">
      <WorkSection />
      <CreateSection />
      <LovesSection />
    </div>
  </div>
</div>

<!-- Diagram lightbox (reused by Create galleries). Robust dialog semantics +
     focus trap + restore live in portfolio-navigation.ts. -->
<div id="pf-lightbox" class="pf-lightbox" role="dialog" aria-modal="true" aria-label="Diagram viewer" hidden>
  <div class="pf-lightbox-backdrop" data-lightbox-close></div>
  <div class="pf-lightbox-panel">
    <button class="pf-lightbox-close" type="button" data-lightbox-close aria-label="Close">&times;</button>
    <img class="pf-lightbox-img" src="" alt="">
    <p class="pf-lightbox-caption"></p>
  </div>
</div>

<script>
  import '../../scripts/portfolio-navigation';
</script>
