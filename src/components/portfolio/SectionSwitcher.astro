---
/**
 * Section switcher — lowercase nav pills (work | create | loves) with an
 * underline on the active tab, left-aligned under a divider (charliekubal
 * style). Semantic <a href="#work"> so it deep-links and works with no JS;
 * the script (portfolio-navigation.ts) upgrades it to a keyboard tablist.
 */
const tabs = [
  { id: 'work', label: 'work' },
  { id: 'create', label: 'create' },
  { id: 'loves', label: 'loves' },
];
---

<div class="pf-switcher-wrap">
  <nav class="pf-switcher" role="tablist" aria-label="Portfolio sections" data-section-switcher>
    {tabs.map((t, i) => (
      <>
        {i > 0 && <span class="pf-tab-sep" aria-hidden="true">|</span>}
        <a
          class="pf-tab"
          class:list={{ 'is-active': i === 0 }}
          id={`tab-${t.id}`}
          href={`#${t.id}`}
          role="tab"
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
          data-section-tab={t.id}
        >{t.label}</a>
      </>
    ))}
  </nav>
</div>
