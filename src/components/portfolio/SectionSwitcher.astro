---
/**
 * Section switcher — a restrained ARIA tablist (work / create / loves).
 * Lowercase labels, active state shown by a subtle gradient underline (not a
 * dashboard pill). Sticky near the top of the content stage. Keyboard support
 * (arrows / Home / End) + hash sync live in portfolio-navigation.ts.
 *
 * Semantic <a href="#work"> so the control still works (and deep-links) with
 * no JavaScript; the script upgrades it to a proper tablist.
 */
const tabs = [
  { id: 'work', label: 'work' },
  { id: 'create', label: 'create' },
  { id: 'loves', label: 'loves' },
];
---

<div class="pf-switcher-wrap">
  <div class="pf-switcher" role="tablist" aria-label="Portfolio sections" data-section-switcher>
    {tabs.map((t, i) => (
      <a
        class="pf-tab"
        class:list={{ 'is-active': i === 0 }}
        id={`tab-${t.id}`}
        href={`#${t.id}`}
        role="tab"
        aria-controls={`panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? '0' : '-1'}
        data-section-tab={t.id}
      >{t.label}</a>
    ))}
  </div>
</div>
