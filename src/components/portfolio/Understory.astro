---
/**
 * The understory: the forest continued behind the reading (styles and the
 * full story in dusk.css). Three drifting CSS layers, plus one drawn shape
 * on wide screens: a banyan bough leaning in at the top right, its aerial
 * roots hanging down the margin. It's the kind of tree that shades Yangon's
 * streets; a quiet silhouette, well clear of the text.
 */
// Deterministic "hand" variation, so the drawing is the same on every build.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const between = (a: number, b: number) => a + (b - a) * rnd();

// The bough runs from the corner down and leftwards; y along it at a given x.
const boughY = (x: number) => 26 + (260 - x) * 0.2 + Math.sin(x * 0.03) * 5;

// Broad leaves clustered along the bough.
const leaves = Array.from({ length: 26 }, (_, i) => {
  const x = 36 + i * 8.6 + between(-4, 4);
  const above = i % 3 !== 0;
  return {
    x,
    y: boughY(x) + (above ? -between(4, 16) : between(5, 13)),
    rx: between(8, 13),
    ry: between(4.2, 6.5),
    rot: between(-50, 40),
  };
});
// Aerial roots: thin, uneven, a few of them forked at the tip.
const roots = Array.from({ length: 8 }, (_, i) => {
  const x = 58 + i * 25 + between(-7, 7);
  const y = boughY(x) + 3;
  const len = between(110, 400) * (i % 3 === 1 ? 0.55 : 1);
  const lean = between(-9, 9);
  let d = `M${x.toFixed(1)} ${y.toFixed(1)}q${(lean * 1.4).toFixed(1)} ${(len * 0.5).toFixed(1)} ${lean.toFixed(1)} ${len.toFixed(1)}`;
  if (i % 3 === 0) d += `m0 0q${between(-9, -4).toFixed(1)} 14 ${between(-12, -6).toFixed(1)} 34`;
  return { d, w: between(1.1, 2.3) };
});
---

<div class="understory" aria-hidden="true">
  <span class="understory-light"></span>
  <svg class="understory-banyan" viewBox="0 0 260 520" preserveAspectRatio="xMaxYMin meet" focusable="false">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      {roots.map((r) => <path d={r.d} stroke-width={r.w.toFixed(1)} />)}
    </g>
    <g fill="currentColor">
      <path d={`M262 8C200 22 120 44 30 ${boughY(30).toFixed(1)}c-6 2-6 6 0 6C120 62 200 48 262 44Z`} />
      {leaves.map((l) => (
        <ellipse cx={l.x.toFixed(1)} cy={l.y.toFixed(1)} rx={l.rx.toFixed(1)} ry={l.ry.toFixed(1)} transform={`rotate(${l.rot.toFixed(0)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`} />
      ))}
    </g>
  </svg>
</div>
