---
/**
 * One featured project as a simple story. Facts come from the canonical
 * project record; the image, CTA label, and note are presentation config.
 *
 * `collapsible` renders it as a grove twig: meta, title and one-line summary
 * as the head, opening to the rest.
 */
import ProjectStoryBody from './ProjectStoryBody.astro';
import { projectYear, sentenceCase, type CareerProject } from '../../lib/career';

interface Props {
  project: CareerProject;
  collapsible?: boolean;
}

const { project: p, collapsible = false } = Astro.props;
const year = projectYear(p);
const meta = `${sentenceCase(p.category)}${year ? ` · ${year}` : ''}`;
const summary = p.website_summary ?? p.summary;
---

{collapsible ? (
  <details class="story twig-details" id={`story-${p.id}`} open>
    <summary class="twig-head">
      <span class="story-meta">{meta}</span>
      <span class="story-title">{p.title}</span>
      <span class="story-summary">{summary}</span>
    </summary>
    <div class="twig-body">
      <ProjectStoryBody project={p} />
    </div>
  </details>
) : (
  <article class="story" id={`story-${p.id}`} aria-labelledby={`story-title-${p.id}`}>
    <p class="story-meta">{meta}</p>
    <h3 class="story-title" id={`story-title-${p.id}`}>{p.title}</h3>
    <p class="story-summary">{summary}</p>
    <ProjectStoryBody project={p} />
  </article>
)}
