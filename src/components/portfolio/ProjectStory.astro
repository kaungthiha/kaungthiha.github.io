---
/**
 * One featured project on the Create branch, as a twig: meta, title and a
 * one-line summary as the head, opening to the result, stack, CTA, note, and
 * image. Facts come from the canonical project record; the image, CTA label,
 * and note are presentation config.
 */
import { portfolioConfig } from '../../data/portfolio/portfolio-config';
import { projectResult, projectYear, sentenceCase, type CareerProject } from '../../lib/career';

interface Props {
  project: CareerProject;
}

const { project: p } = Astro.props;
const { ctaLabels, images, notes } = portfolioConfig.create;
const year = projectYear(p);
const meta = `${sentenceCase(p.category)}${year ? ` · ${year}` : ''}`;
const link = p.links?.[0];
const external = link ? link.url.startsWith('http') || link.kind === 'pdf' : false;
const result = projectResult(p);
const image = images[p.id];
const note = notes[p.id];
---

<details class="story twig-details" id={`story-${p.id}`} open>
  <summary class="twig-head">
    <span class="story-meta">{meta}</span>
    <span class="story-title">{p.title}</span>
    <span class="story-summary">{p.website_summary ?? p.summary}</span>
  </summary>
  <div class="twig-body">
    {result && <p class="story-result">{result}</p>}
    {p.technologies && p.technologies.length > 0 && <p class="story-stack">{p.technologies.join(' · ')}</p>}
    {link && (
      <p class="story-cta">
        <a
          class="text-link"
          href={link.url}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener' : undefined}
        >{ctaLabels[link.kind]} →</a>
      </p>
    )}
    {note && <p class="story-note">{note}</p>}

    {image && (
      <figure class="story-figure">
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
      </figure>
    )}
  </div>
</details>
