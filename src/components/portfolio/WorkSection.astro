---
/**
 * Work — a short vertical chronology, readable without clicking anything.
 * Earlier roles sit behind a native <details>. The résumé link only renders
 * when the PDF actually exists in public/ at build time.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import {
  workHeading,
  workIntro,
  roles,
  earlierRoles,
  skills,
  resumeHref,
} from '../../data/work';

const hasResume = existsSync(join(process.cwd(), 'public', resumeHref));
---

<section class="home-section" id="work" aria-labelledby="work-title">
  <p class="section-label">work</p>
  <h2 class="section-heading" id="work-title">{workHeading}</h2>
  <p class="section-intro">{workIntro}</p>

  <ol class="chronology">
    {roles.map((r) => (
      <li class="chapter">
        <p class="chapter-dates">{r.dates}</p>
        <div class="chapter-body">
          <h3 class="chapter-company">{r.company}</h3>
          <p class="chapter-role">{r.role}</p>
          <p class="chapter-summary">{r.summary}</p>
          {r.result && <p class="chapter-result">{r.result}</p>}
        </div>
      </li>
    ))}
  </ol>

  <details class="earlier">
    <summary>Earlier work</summary>
    <ol class="chronology chronology--compact">
      {earlierRoles.map((r) => (
        <li class="chapter">
          <p class="chapter-dates">{r.dates}</p>
          <div class="chapter-body">
            <h3 class="chapter-company">{r.company}</h3>
            <p class="chapter-role">{r.role}</p>
            <p class="chapter-summary">{r.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </details>

  <p class="skills-line">
    {skills.map((g) => (
      <span class="skills-group"><span class="skills-name">{g.group}</span> {g.items.join(' · ')}</span>
    ))}
  </p>

  {hasResume && (
    <p class="section-cta">
      <a class="text-link" href={resumeHref} target="_blank" rel="noopener">Résumé (PDF) →</a>
    </p>
  )}
</section>
