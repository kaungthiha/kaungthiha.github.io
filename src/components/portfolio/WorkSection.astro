---
/**
 * Work — a short, reference-site-style summary of what I do (not a full,
 * expanded résumé). A few narrative lines + a compact skills line + a résumé
 * download for anyone who wants the detail. Content from src/data/work.ts.
 */
import { workIntro, workSummary, skills, resumeHref } from '../../data/work';
---

<section
  class="pf-section pf-work"
  id="panel-work"
  role="tabpanel"
  aria-labelledby="tab-work"
  data-section="work"
>
  <header class="pf-section-head">
    <div>
      <p class="pf-eyebrow">work</p>
      <h2 class="pf-section-title">I work where product, data, and AI overlap.</h2>
    </div>
    <a class="pf-quiet-link" href={resumeHref} target="_blank" rel="noopener">
      Download résumé
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
    </a>
  </header>

  <p class="pf-intro">{workIntro}</p>

  <ul class="pf-summary" role="list">
    {workSummary.map((line) => <li>{line}</li>)}
  </ul>

  <div class="pf-skills" aria-label="Skills">
    {skills.map((g) => (
      <p class="pf-skill-line">
        <span class="pf-skill-group">{g.group}</span>
        <span class="pf-skill-items">{g.items.join(' · ')}</span>
      </p>
    ))}
  </div>
</section>
