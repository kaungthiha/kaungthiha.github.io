---
/**
 * Work — a concise career summary: one line per role, newest first, then a
 * link to the full timeline on /career/. Every fact comes from the canonical
 * dataset via src/lib/career.ts; this file only decides the layout.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { portfolioConfig } from '../../data/portfolio/portfolio-config';
import { getCareerSummary, getCurrentRole, getPublicSkills } from '../../lib/career';

const { work, skillGroups } = portfolioConfig;
const milestones = getCareerSummary(work.summaryExperienceIds);
const current = getCurrentRole();
const skills = getPublicSkills(skillGroups);
const hasResume = existsSync(join(process.cwd(), 'public', work.resumeHref));
---

<section class="home-section" id="work" aria-labelledby="work-title">
  <p class="section-label">work</p>
  <h2 class="section-heading" id="work-title">{work.heading}</h2>
  <p class="section-intro">
    {work.intro}
    {current && (
      <> Right now: {current.role.canonical_title}{current.role.team_or_scope && `, ${current.role.team_or_scope}`}, at {current.experience.organization}.</>
    )}
  </p>

  <ol class="chronology chronology--milestones">
    {milestones.map((m) => (
      <li class="chapter">
        <p class="chapter-dates">{m.years}</p>
        <div class="chapter-body">
          <h3 class="chapter-company">{m.organization}</h3>
          <p class="chapter-role">{m.title}{m.scope && ` · ${m.scope}`}</p>
        </div>
      </li>
    ))}
  </ol>

  <p class="section-cta">
    <a class="text-link" href={work.careerPageHref}>{work.careerCtaLabel} →</a>
  </p>

  {skills.length > 0 && (
    <p class="skills-line">
      {skills.map((g) => (
        <span class="skills-group"><span class="skills-name">{g.label}</span> {g.items.join(' · ')}</span>
      ))}
    </p>
  )}

  {hasResume && (
    <p class="section-cta">
      <a class="text-link" href={work.resumeHref} target="_blank" rel="noopener">Résumé (PDF) →</a>
    </p>
  )}
</section>
